<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C14">

    <!-- Optional User Custom Gallery Theme Wallpaper -->
    <ImageView
        android:id="@+id/customThemeBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.38"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- MAIN AUDIO LIBRARY SCREEN -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. SABSE UPAR TOP BRAND HEADER: "Hybrid Music Player ★" + Equalizer + 3-Dot -->
        <LinearLayout
            android:id="@+id/topBrandBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/appTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Hybrid Music Player ★"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/profileThemeButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:padding="8dp" />

            <ImageView
                android:id="@+id/topSortMenuBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:padding="8dp" />
        </LinearLayout>

        <!-- 2. Sleek Category Tabs Row: Songs, Folders, Albums, Artists, Video-Audio, Favorites -->
        <LinearLayout
            android:id="@+id/topHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_below="@id/topBrandBar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <HorizontalScrollView
                android:id="@+id/categoryTabsScroll"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabAllSongs"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Songs"
                        android:textColor="#0A0A10"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabFolders"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Folders"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabPlaylists"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Albums"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabArtists"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Artists"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabVideoAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Video-Audio"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabFavorites"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Favorites"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 3. Studio Action Row: Shuffle All + Random + Song Count (Duplicate Top Puppy Hidden!) -->
        <LinearLayout
            android:id="@+id/subShuffleHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_below="@id/topHeaderBar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/playShuffleAllBtn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Shuffle All"
                android:textColor="#0A0A10"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/randomPlayBtn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Random"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/totalSongsCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:text="0 Songs"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Hidden so only 1 Cute Puppy appears on screen -->
            <com.hybridmusic.player.DancingPuppyView
                android:id="@+id/headerPuppyView"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 4. COMPACT SLEEK BOTTOM NAVIGATION BAR (Smaller & Futuristic) -->
        <LinearLayout
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="4dp"
            android:background="#0D131C"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/navSongsBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:padding="0dp"
                android:text="🎵 Songs"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navSearchBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:padding="0dp"
                android:text="🔍 Search"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navSettingsBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:padding="0dp"
                android:text="⚙️ MI Studio"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5. Compact Floating Mini-Player Bar (With 3-Dot Button) -->
        <LinearLayout
            android:id="@+id/miniPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_above="@id/bottomNavBar"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/miniThumbnail"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="Tap any song to play"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/miniArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Hi-Res Studio Audio"
                    android:textColor="#D8E2F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/miniPrevBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:padding="8dp" />

            <ImageView
                android:id="@+id/miniPlayPauseBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="5dp"
                android:padding="9dp" />

            <ImageView
                android:id="@+id/miniNextBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:padding="8dp" />

            <ImageView
                android:id="@+id/miniThreeDotBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp" />
        </LinearLayout>

        <!-- 6. Dynamic Content Area -->
        <FrameLayout
            android:id="@+id/mainContentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/miniPlayerBar"
            android:layout_below="@id/subShuffleHeaderRow" />
    </RelativeLayout>

    <!-- FULL STUDIO AUDIO PLAYER OVERLAY (10% SMALLER SLEEK CONTROLS WITH PURE-WHITE VECTOR ICONS) -->
    <RelativeLayout
        android:id="@+id/fullPlayerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#080C14"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <!-- Top Bar (10% Smaller 42dp Pure-White Vector Buttons) -->
        <LinearLayout
            android:id="@+id/fpTopBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fpCloseBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fpSongTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="HI-RES STUDIO AUDIO"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fpSongArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Swipe Cover Left/Right for Next"
                    android:textColor="#D8E2F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hidden so only 1 Cute Puppy appears on screen -->
            <com.hybridmusic.player.DancingPuppyView
                android:id="@+id/fpPuppyView"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/fpTopEqualizerBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:padding="10dp" />

            <ImageView
                android:id="@+id/fpThreeDotBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="10dp" />
        </LinearLayout>

        <!-- Center Album Art / Rotating Vinyl Disc + Favorite Heart + Online Lyrics -->
        <FrameLayout
            android:id="@+id/fpCenterArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/fpBottomSwappableRow"
            android:layout_below="@id/fpTopBar"
            android:layout_marginVertical="8dp">

            <com.hybridmusic.player.AlbumArtDiscView
                android:id="@+id/fpAlbumArtDiscView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/fpFavoriteHeartBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:padding="10dp" />

            <TextView
                android:id="@+id/fpQuickLyricsBtn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Lyrics"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/fpLyricsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F20A0D14"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/fpLyricsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"
                        android:text="Tap Find Online Lyrics..."
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/fpFindLyricsOnlineBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Find Online"
                        android:textColor="#000000"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/fpLyricsFavBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#1E293B"
                        android:text="Favorite"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/fpBackToArtBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="#334155"
                        android:text="Art"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Quick Studio Pills Row Above Waveform (10% Smaller 34dp Height + Pure-White Vector Icons) -->
        <LinearLayout
            android:id="@+id/fpBottomSwappableRow"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_above="@+id/fpSeekSection"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fpSlot0Btn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:singleLine="true"
                android:text="Equali"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpSlot1Btn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:singleLine="true"
                android:text="A-B"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpSlot2Btn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:singleLine="true"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpSlot3Btn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:singleLine="true"
                android:text="Timer"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pure-White Waveform ("Lambe Dande") & Time Labels -->
        <LinearLayout
            android:id="@+id/fpSeekSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/fpMainControlsRow"
            android:layout_marginVertical="5dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fpCurrentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fpTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.hybridmusic.player.WaveformSeekBarView
                android:id="@+id/fpWaveformSeekBar"
                android:layout_width="match_parent"
                android:layout_height="42dp" />
        </LinearLayout>

        <!-- SLEEK 10% SMALLER PURE-WHITE TRANSPORT ROW (46dp / 52dp / 66dp) -->
        <LinearLayout
            android:id="@+id/fpMainControlsRow"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_above="@+id/fpBottomFooterRow"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fpShuffleBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="14dp"
                android:padding="11dp" />

            <ImageView
                android:id="@+id/fpPrevBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="16dp"
                android:padding="12dp" />

            <ImageView
                android:id="@+id/fpPlayPauseBtn"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginEnd="16dp"
                android:padding="15dp" />

            <ImageView
                android:id="@+id/fpNextBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="14dp"
                android:padding="12dp" />

            <ImageView
                android:id="@+id/fpRepeatBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp" />
        </LinearLayout>

        <!-- Sleek 10% Smaller Bottom Dock Bar: Pocket Shake + Playing Queue + Bottom 3-Dot ("⋮") -->
        <LinearLayout
            android:id="@+id/fpBottomFooterRow"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fpPocketShakeBtn"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:text="Shake: OFF"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpQueueBtn"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:text="Queue (0/0)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/fpBottomThreeDotBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp" />
        </LinearLayout>

        <!-- RIGHT-TO-LEFT SLIDE PLAYING QUEUE OVERLAY -->
        <FrameLayout
            android:id="@+id/queueBackdropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#AA000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/queueSlidePanel"
                android:layout_width="320dp"
                android:layout_height="560dp"
                android:layout_gravity="end|center_vertical"
                android:background="#0E151F"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/queueHeaderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Playing Queue (0/0)"
                        android:textColor="#FFFFFF"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/queueCloseCutBtn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="8dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/queueRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>

    <!-- THE SINGLE SUPER-CUTE FLOATING MUSO PUPPY (Only 1 Puppy on Screen!) -->
    <com.hybridmusic.player.DancingPuppyView
        android:id="@+id/floatingGuddaView"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="125dp" />

