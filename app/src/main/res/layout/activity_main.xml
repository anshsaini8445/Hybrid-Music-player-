<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090E15">

    <!-- Optional Custom Gallery Theme Photo Background -->
    <ImageView
        android:id="@+id/customThemeBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- MAIN LIBRARY LAYER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Pill Tabs Row: Songs, Folders, Albums, Artists, Video-Audio, Favorites + Sort -->
        <LinearLayout
            android:id="@+id/topHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp">

            <HorizontalScrollView
                android:id="@+id/categoryTabsScroll"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabAllSongs"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Songs"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabFolders"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Folders"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabPlaylists"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Albums"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabArtists"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Artists"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabVideoAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Video-Audio"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabFavorites"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Favorites"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/topSortMenuBtn"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="↓≡"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sub-Row: Play / Shuffle All Pill + Total Songs + Header Gudda + Star + Theme Icon -->
        <LinearLayout
            android:id="@+id/subShuffleHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/topHeaderBar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/playShuffleAllBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Play / Shuffle All"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/totalSongsCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="0 Songs"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.hybridmusic.player.DancingPuppyView
                android:id="@+id/headerPuppyView"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/appTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="★"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/profileThemeButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Bottom Navigation Bar (Songs, Search, Settings MI) -->
        <LinearLayout
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_alignParentBottom="true"
            android:background="#0D131C"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/navSongsBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:text="🎵 Songs"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navSearchBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:text="🔍 Search"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navSettingsBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:text="⚙️ Settings (MI)"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Floating Mini Player Bar (Swipe Left/Right on Mini Player changes song!) -->
        <LinearLayout
            android:id="@+id/miniPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_above="@id/bottomNavBar"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/miniThumbnail"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_media_play" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="Tap or Hold 2s on any song to play"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/miniArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Swipe here left/right to change song"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/miniPlayPauseBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="▶"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniNextBtn"
                android:layout_width="42dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Content Container -->
        <FrameLayout
            android:id="@+id/mainContentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/miniPlayerBar"
            android:layout_below="@id/subShuffleHeaderRow" />
    </RelativeLayout>

    <!-- FULL MUSIC PLAYER SCREEN (ALL CONTROLS PURE WHITE #FFFFFF & LARGER REALISTIC SIZE) -->
    <RelativeLayout
        android:id="@+id/fullPlayerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#090E15"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <!-- Top Bar: Down Button + Marquee Title & Singer + Dancing Gudda + Share/Options -->
        <LinearLayout
            android:id="@+id/fpTopBar"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fpCloseBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⌄"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fpSongTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="Song Title"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fpSongArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Singer Name"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.hybridmusic.player.DancingPuppyView
                android:id="@+id/fpPuppyView"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/fpShareBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="🔗"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Album Art / Rotating Vinyl Disc + Online Lyrics Overlay -->
        <FrameLayout
            android:id="@+id/fpCenterArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/fpBottomSwappableRow"
            android:layout_below="@id/fpTopBar"
            android:layout_marginVertical="10dp">

            <com.hybridmusic.player.AlbumArtDiscView
                android:id="@+id/fpAlbumArtDiscView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Quick Lyrics Pill on Bottom-Right of Album Art -->
            <TextView
                android:id="@+id/fpQuickLyricsBtn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="📝 Lyrics"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/fpLyricsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#EE0B111A"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/fpLyricsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"
                        android:text="Tap Find Online Lyrics..."
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/fpFindLyricsOnlineBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="🌐 Find Online"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/fpLyricsFavBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#1E293B"
                        android:text="♡ Favorite"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/fpBackToArtBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#334155"
                        android:text="Art ↩"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Action Row Above Waveform: ALL PURE WHITE & LARGER (Equali, A-B, 1.0x, Timer, 3-Dot) -->
        <LinearLayout
            android:id="@+id/fpBottomSwappableRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_above="@+id/fpSeekSection"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fpSlot0Btn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🎚 Equali"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpSlot1Btn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🔁 A-B"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpSlot2Btn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⚡ 1.0x"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpSlot3Btn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🕒 Timer"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpThreeDotBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Time Labels + Waveform ("Lambe Dande") Seekbar Section -->
        <LinearLayout
            android:id="@+id/fpSeekSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/fpMainControlsRow"
            android:layout_marginVertical="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fpCurrentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fpTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.hybridmusic.player.WaveformSeekBarView
                android:id="@+id/fpWaveformSeekBar"
                android:layout_width="match_parent"
                android:layout_height="52dp" />
        </LinearLayout>

        <!-- Main Transport Controls: LARGER REALISTIC PURE WHITE (Shuffle, Prev, Play/Pause, Next, Repeat) -->
        <LinearLayout
            android:id="@+id/fpMainControlsRow"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_above="@+id/fpBottomFooterRow"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fpShuffleBtn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="🔀"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpPrevBtn"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="8dp"
                android:gravity="center"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpPlayPauseBtn"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:gravity="center"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpNextBtn"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="8dp"
                android:gravity="center"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpRepeatBtn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="🔁"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Footer Row: Pure White Pocket Shake + Playing Queue + Three Dot (⋮) instead of Cross -->
        <LinearLayout
            android:id="@+id/fpBottomFooterRow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fpPocketShakeBtn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp"
                android:text="📳 Pocket Shake: OFF"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpQueueBtn"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="🎵 Playing Queue (0/0)"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- Three Dot (⋮) at Bottom Corner in place of Cross as Requested -->
            <TextView
                android:id="@+id/fpBottomThreeDotBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- RIGHT-TO-LEFT SLIDE PLAYING QUEUE OVERLAY -->
        <FrameLayout
            android:id="@+id/queueBackdropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#AA000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/queueSlidePanel"
                android:layout_width="315dp"
                android:layout_height="560dp"
                android:layout_gravity="end|center_vertical"
                android:background="#0E151F"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/queueHeaderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Playing Queue (0/0)"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Three Dot (⋮) / Close Button -->
                    <TextView
                        android:id="@+id/queueCloseCutBtn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:text="⋮"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/queueRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>

    <!-- FLOATING DRAGGABLE MUSO GUDDA (Dances Anywhere on Screen!) -->
    <com.hybridmusic.player.DancingPuppyView
        android:id="@+id/floatingGuddaView"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="140dp" />

    <!-- SCREENSHOT (1000061267.jpg) TOP VOLUME BANNER PATTI (80% + White Bar + 4 Dots) -->
    <com.hybridmusic.player.VolumeBannerView
        android:id="@+id/volumeBannerView"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="36dp" />

</FrameLayout>
