<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090E15">

    <!-- Optional User Custom Gallery Theme Wallpaper -->
    <ImageView
        android:id="@+id/customThemeBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.38"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- MAIN AUDIO LIBRARY SCREEN -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Top Category Tabs + Larger Pure-White Equalizer & 3-Dot Buttons -->
        <LinearLayout
            android:id="@+id/topHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp">

            <HorizontalScrollView
                android:id="@+id/categoryTabsScroll"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabAllSongs"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Songs"
                        android:textColor="#0A0A10"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabFolders"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Folders"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabPlaylists"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Albums"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabArtists"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Artists"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabVideoAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Video-Audio"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabFavorites"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Favorites"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <ImageView
                android:id="@+id/profileThemeButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:padding="10dp" />

            <ImageView
                android:id="@+id/topSortMenuBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:padding="10dp" />
        </LinearLayout>

        <!-- 2. Studio Action Row: Shuffle All + Random + Song Count + Muso Dancing Gudda -->
        <LinearLayout
            android:id="@+id/subShuffleHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/topHeaderBar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/playShuffleAllBtn"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Shuffle All"
                android:textColor="#0A0A10"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/randomPlayBtn"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:text="Random"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/totalSongsCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:text="0 Songs"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <com.hybridmusic.player.DancingPuppyView
                android:id="@+id/headerPuppyView"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/appTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="★"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Bottom Navigation Bar (Songs, Search, Settings MI) -->
        <LinearLayout
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_alignParentBottom="true"
            android:background="#0D131C"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/navSongsBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:text="🎵 Songs"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navSearchBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:text="🔍 Search"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navSettingsBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:text="⚙️ Settings (MI)"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. Upgraded Bottom Mini-Player Bar (Pure-White Vector Prev, Play/Pause, Next & 3-Dot Button) -->
        <LinearLayout
            android:id="@+id/miniPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_above="@id/bottomNavBar"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/miniThumbnail"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="Tap any song to play"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/miniArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Hi-Res Studio Audio"
                    android:textColor="#D8E2F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/miniPrevBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:padding="9dp" />

            <ImageView
                android:id="@+id/miniPlayPauseBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:padding="10dp" />

            <ImageView
                android:id="@+id/miniNextBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:padding="9dp" />

            <!-- Bottom 3-Dot Button Instead of Cross 'X' -->
            <ImageView
                android:id="@+id/miniThreeDotBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp" />
        </LinearLayout>

        <!-- 5. Dynamic Content Area -->
        <FrameLayout
            android:id="@+id/mainContentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/miniPlayerBar"
            android:layout_below="@id/subShuffleHeaderRow" />
    </RelativeLayout>

    <!-- FULL STUDIO AUDIO PLAYER OVERLAY (100% PURE WHITE #FFFFFF LARGER REALISTIC CONTROLS) -->
    <RelativeLayout
        android:id="@+id/fullPlayerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#090E15"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <!-- Top Bar: Pure-White Back/Down, Song Title & Singer, Dancing Gudda, Equalizer & 3-Dot Studio -->
        <LinearLayout
            android:id="@+id/fpTopBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fpCloseBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="11dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fpSongTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="HI-RES STUDIO AUDIO"
                    android:textColor="#FFFFFF"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fpSongArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Swipe Cover Left/Right for Next"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.hybridmusic.player.DancingPuppyView
                android:id="@+id/fpPuppyView"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/fpTopEqualizerBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:padding="11dp" />

            <ImageView
                android:id="@+id/fpThreeDotBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="11dp" />
        </LinearLayout>

        <!-- Center Album Art / Rotating Vinyl Disc + Favorite Heart + Online Lyrics -->
        <FrameLayout
            android:id="@+id/fpCenterArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/fpBottomSwappableRow"
            android:layout_below="@id/fpTopBar"
            android:layout_marginVertical="10dp">

            <com.hybridmusic.player.AlbumArtDiscView
                android:id="@+id/fpAlbumArtDiscView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Pure-White Favorite Heart Button on Bottom-Start -->
            <ImageView
                android:id="@+id/fpFavoriteHeartBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:padding="11dp" />

            <!-- Pure-White Lyrics Trigger Pill on Bottom-End -->
            <TextView
                android:id="@+id/fpQuickLyricsBtn"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Lyrics"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/fpLyricsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F20A0D14"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/fpLyricsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"
                        android:text="Tap Find Online Lyrics..."
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/fpFindLyricsOnlineBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Find Online"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/fpLyricsFavBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#1E293B"
                        android:text="Favorite"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/fpBackToArtBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#334155"
                        android:text="Art"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Quick Studio Pills Row Above Waveform (100% Pure White) -->
        <LinearLayout
            android:id="@+id/fpBottomSwappableRow"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_above="@+id/fpSeekSection"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fpSlot0Btn"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Equalizer"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpSlot1Btn"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="AB Repeat"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpSlot2Btn"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1.0x Speed"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpSlot3Btn"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sleep Timer"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pure-White Waveform ("Lambe Dande") & Time Labels -->
        <LinearLayout
            android:id="@+id/fpSeekSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/fpMainControlsRow"
            android:layout_marginVertical="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fpCurrentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fpTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.hybridmusic.player.WaveformSeekBarView
                android:id="@+id/fpWaveformSeekBar"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- LARGER PURE-WHITE STUDIO TRANSPORT ROW (Shuffle, Prev, Giant Play/Pause, Next, Loop/Repeat) -->
        <LinearLayout
            android:id="@+id/fpMainControlsRow"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_above="@+id/fpBottomFooterRow"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fpShuffleBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="14dp"
                android:padding="12dp" />

            <ImageView
                android:id="@+id/fpPrevBtn"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginEnd="16dp"
                android:padding="13dp" />

            <ImageView
                android:id="@+id/fpPlayPauseBtn"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginEnd="16dp"
                android:padding="17dp" />

            <ImageView
                android:id="@+id/fpNextBtn"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginEnd="14dp"
                android:padding="13dp" />

            <ImageView
                android:id="@+id/fpRepeatBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Bottom Dock Bar: Pocket Shake + Playing Queue + Bottom 3-Dot ("⋮") Button Instead of Cross -->
        <LinearLayout
            android:id="@+id/fpBottomFooterRow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fpPocketShakeBtn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Pocket Shake: OFF"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fpQueueBtn"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Playing Queue (0/0)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Bottom 3-Dot Button (Replaces Cross 'X') -->
            <ImageView
                android:id="@+id/fpBottomThreeDotBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="10dp" />
        </LinearLayout>

        <!-- RIGHT-TO-LEFT SLIDE PLAYING QUEUE OVERLAY -->
        <FrameLayout
            android:id="@+id/queueBackdropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#AA000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/queueSlidePanel"
                android:layout_width="320dp"
                android:layout_height="560dp"
                android:layout_gravity="end|center_vertical"
                android:background="#0E151F"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/queueHeaderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Playing Queue (0/0)"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- 3-Dot Close Button Instead of Cross 'X' -->
                    <ImageView
                        android:id="@+id/queueCloseCutBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="9dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/queueRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>

    <!-- FLOATING DRAGGABLE MUSO GUDDA (Dances Anywhere on Screen!) -->
    <com.hybridmusic.player.DancingPuppyView
        android:id="@+id/floatingGuddaView"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="145dp" />

    <!-- SCREENSHOT (1000061267.jpg) TOP VOLUME BANNER PATTI (80% + White Bar + 4 Dots) -->
    <com.hybridmusic.player.VolumeBannerView
        android:id="@+id/volumeBannerView"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="36dp" />

</FrameLayout>
