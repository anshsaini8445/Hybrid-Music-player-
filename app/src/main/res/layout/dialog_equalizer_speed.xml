<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#111827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:text="PLAYit 5-Band Equalizer • Speed • Timer"
            android:textColor="#00E5FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Equalizer Presets Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/presetFlatBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Normal"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetBassBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Bass"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetDjBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="DJ Club"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetVocalBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Vocal"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 5-Band Equalizer Sliders -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="60Hz (Deep Sub-Bass)"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
        <SeekBar
            android:id="@+id/eqBand1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="230Hz (Warm Punch)"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
        <SeekBar
            android:id="@+id/eqBand2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="910Hz (Clear Vocals)"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
        <SeekBar
            android:id="@+id/eqBand3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3.6kHz (Treble Presence)"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
        <SeekBar
            android:id="@+id/eqBand4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="14kHz (HD Air Sparkle)"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
        <SeekBar
            android:id="@+id/eqBand5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sub-Woofer Bass Boost"
            android:textColor="#FF2E93"
            android:textSize="13sp"
            android:textStyle="bold" />
        <SeekBar
            android:id="@+id/bassBoostSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0" />

        <!-- Smooth Playback Speed Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/speedTextValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Playback Speed: 1.00x"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/resetSpeedBtn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="1.0x"
                android:textSize="11sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/speedSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:max="50"
            android:progress="12" />

        <!-- Smart Sleep Timer Presets + Custom Minutes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Sleep Timer (Preset + Custom Minutes)"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/timerOffBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Off"
                android:textSize="10sp" />

            <Button
                android:id="@+id/timer15Btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="15m"
                android:textSize="10sp" />

            <Button
                android:id="@+id/timer30Btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="30m"
                android:textSize="10sp" />

            <Button
                android:id="@+id/timer60Btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="60m"
                android:textSize="10sp" />

            <Button
                android:id="@+id/timer90Btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="90m"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/customMinuteInput"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:hint="Custom mins (2, 5, 75, 80)"
                android:inputType="number"
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/setCustomTimerButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#00E5FF"
                android:text="Set"
                android:textColor="#000000" />
        </LinearLayout>

        <Button
            android:id="@+id/closeDialogBtn"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:backgroundTint="#334155"
            android:text="Done / Close"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
