<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/eqDialogRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Studio Header (No Ugly Cross 'X', Uses Sleek 3-Dot '⋮' Pill) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HI-RES ACOUSTIC STUDIO"
                    android:textColor="#FFFFFF"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pure Buttonless Equalizer • Speed Dial • Smart Timer"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/closeDialogTopBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 1: BUTTONLESS 5-BAND DOLBY EQUALIZER & SUB-BASS -->
        <LinearLayout
            android:id="@+id/eqCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="🎚️ 5-BAND MASTER SPECTRUM (LIVE dB)"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Band 1: 60Hz -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="60Hz Sub"
                    android:textColor="#E2E8F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/eqBand1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />
                <TextView
                    android:id="@+id/eqVal1"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0 dB"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Band 2: 230Hz -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="230Hz Punch"
                    android:textColor="#E2E8F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/eqBand2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />
                <TextView
                    android:id="@+id/eqVal2"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0 dB"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Band 3: 910Hz -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="910Hz Vocal"
                    android:textColor="#E2E8F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/eqBand3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />
                <TextView
                    android:id="@+id/eqVal3"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0 dB"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Band 4: 3.6kHz -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="3.6kHz Crisp"
                    android:textColor="#E2E8F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/eqBand4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />
                <TextView
                    android:id="@+id/eqVal4"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0 dB"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Band 5: 14kHz -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="14kHz Air"
                    android:textColor="#E2E8F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/eqBand5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />
                <TextView
                    android:id="@+id/eqVal5"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0 dB"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sub-Woofer Analog Bass Boost Slider -->
            <TextView
                android:id="@+id/bassTextValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🔊 Sub-Woofer Deep Bass: 0%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/bassBoostSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <!-- CARD 2: MODERN SPEEDOMETER DIAL & LOFI PITCH / REVERB -->
        <LinearLayout
            android:id="@+id/speedCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/speedTextValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Tempo Speed Dial: 1.00x (Normal Studio)"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/speedSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="50"
                android:progress="12" />

            <TextView
                android:id="@+id/pitchTextValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🎛️ Lofi Pitch &amp; Hall Reverb: 1.00x"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/pitchSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="30"
                android:progress="10" />
        </LinearLayout>

        <!-- CARD 3: MODERN SLEEP TIMER DIAL (SLIDE ANY MINUTE: 0m to 120m) -->
        <LinearLayout
            android:id="@+id/timerCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/timerTextValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏳ Smart Sleep Timer Dial: OFF (Slide to Set Minutes)"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/timerSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="120"
                android:progress="0" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
