<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D141E">

    <LinearLayout
        android:id="@+id/eqDialogRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Header with Close (X) Button like Screenshot 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/dialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sound &amp; Pitch Lab • 5-Band Dolby EQ"
                android:textColor="#00E5FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/closeDialogTopBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="#1E293B"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SECTION 1: SOUND & PITCH LAB (LOFI / SLOWED + REVERB) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🎛️ Sound &amp; Pitch Lab (Lofi / Slowed + Reverb)"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/lofiNormalBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Original"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/lofiSlowedReverbBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#00E5FF"
                android:text="Slowed+Reverb"
                android:textColor="#000000"
                android:textSize="9sp" />

            <Button
                android:id="@+id/lofiChillBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Lofi Chill"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/lofiNightcoreBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Nightcore"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Smooth Playback Speed Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/speedTextValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Playback Speed: 1.00x"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/resetSpeedBtn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#1E293B"
                android:text="Reset 1.0x"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/speedSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="12" />

        <!-- Real Audio Pitch Slider (0.50x Deep to 2.00x High) -->
        <TextView
            android:id="@+id/pitchTextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Voice Pitch Shift: 1.00x (Normal)"
            android:textColor="#FF2E93"
            android:textSize="12sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/pitchSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:max="30"
            android:progress="10" />

        <!-- SECTION 2: 5-BAND DOLBY EQUALIZER & BASS BOOST -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🎚️ 5-Band Dolby Equalizer &amp; Sub-Woofer Bass"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/presetFlatBtn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Flat"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/presetBassBtn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Dolby Bass"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/presetDjBtn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="DJ Club"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/presetVocalBtn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="HD Vocal"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="60Hz (Deep Sub-Bass)"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />
        <SeekBar
            android:id="@+id/eqBand1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="230Hz (Warm Punch)"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />
        <SeekBar
            android:id="@+id/eqBand2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="910Hz (Mid Clarity)"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />
        <SeekBar
            android:id="@+id/eqBand3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3.6kHz (Treble Sparkle)"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />
        <SeekBar
            android:id="@+id/eqBand4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="14kHz (Dolby Air HD)"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />
        <SeekBar
            android:id="@+id/eqBand5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sub-Woofer Bass Boost"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <SeekBar
            android:id="@+id/bassBoostSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:max="100"
            android:progress="0" />

        <!-- SECTION 3: SMART SLEEP TIMER (15m, 30m, 60m, 90m + CUSTOM MINUTES) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕒 Smart Sleep Timer (Preset + Custom Minutes)"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/timerOffBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Off"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/timer15Btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="15m"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/timer30Btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="30m"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/timer60Btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="60m"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/timer90Btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="90m"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/customMinuteInput"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:hint="Custom mins (e.g. 2, 5, 75, 80)"
                android:inputType="number"
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/setCustomTimerButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#00E5FF"
                android:text="Set Timer"
                android:textColor="#000000"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/closeDialogBtn"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:backgroundTint="#1E293B"
            android:text="Done / Close"
            android:textColor="#00E5FF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
